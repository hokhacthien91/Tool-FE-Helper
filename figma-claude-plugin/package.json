{
  "name": "figma-claude-plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "vite build --config vite.config.code.ts",
    "build:ui": "vite build --config vite.config.ui.ts",
    "dev": "concurrently \"npm run dev:code\" \"npm run dev:ui\"",
    "dev:code": "vite build --config vite.config.code.ts --watch",
    "dev:ui": "vite build --config vite.config.ui.ts --watch",
    "backend": "tsx backend/server.ts",
    "backend:dev": "tsx watch backend/server.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@figma/plugin-typings": "^1.106.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
