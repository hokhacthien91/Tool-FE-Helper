{
  "id": "com.oai.bannercloner",
  "name": "Banner Cloner",
  "version": "1.0.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "banner-cloner-panel",
      "label": {
        "default": "Banner Cloner"
      },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 900, "height": 1200 },
      "preferredDockedSize": { "width": 360, "height": 520 },
      "preferredFloatingSize": { "width": 380, "height": 560 }
    }
  ]
}