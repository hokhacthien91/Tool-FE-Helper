{
  "id": "com.oai.bannercloner.v2",
  "name": "Banner Cloner",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icon.png",
      "scale": [1, 2],
      "theme": ["all"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true,
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "banner-cloner-pro-panel",
      "label": {
        "default": "Banner Cloner"
      },
      "minimumSize": {
        "width": 320,
        "height": 520
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      }
    }
  ]
}