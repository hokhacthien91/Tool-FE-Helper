{
  "id": "com.gg.content-replacer.v1",
  "name": "Content Replacer",
  "version": "0.2.6",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true,
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": [""]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "content-replacer-panel",
      "label": {
        "default": "Content Replacer"
      },
      "minimumSize": {
        "width": 320,
        "height": 520
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 780
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 820
      }
    }
  ]
}
