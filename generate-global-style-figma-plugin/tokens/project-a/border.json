      "4": { "value": "4px", "description": "4px border width" },
      "5": { "value": "5px", "description": "5px border width" },
      "6": { "value": "6px", "description": "6px border width" },
      "7": { "value": "7px", "description": "7px border width" },
      "8": { "value": "8px", "description": "8px border width" },
      "9": { "value": "9px", "description": "9px border width" },
      "10": { "value": "10px", "description": "10px border width" },
      "11": { "value": "11px", "description": "11px border width" },
      "DEFAULT": "1px"
    }
  }
}