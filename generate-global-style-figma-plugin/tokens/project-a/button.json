{
  "config": {
    "examples": {
      "defaultText": "Button",
      "textLinkText": "Text link"
    },
    "icons": {
      "default": "arrow--right"
    }
  },

  "button": {
    "variants": {
      "state": ["default", "hover", "disabled"],
      "color": ["primary", "secondary", "light", "dark", "tertiary"],
      "size": ["large", "small"],
      "type": ["fill", "outline"]
    },

    "base": {
      "layout": {
        "direction": "horizontal",
        "align": "center",
        "gap": 8
      },
      "borderRadius": 4,
      "borderWidth": 1,
      "font": {
        "family": "Lato",
        "weight": 600,
        "size": {
          "large": 16,
          "small": 14
        },
        "lineHeight": {
          "large": 24,
          "small": 20
        }
      }
    },

    "sizes": {
      "large": { "padding": { "x": 24, "y": 12 } },
      "small": { "padding": { "x": 16, "y": 8 } }
    },

    "styles": {
      "fill": {
        "primary": {
          "default": { "text": "color.white", "background": "color.primary.300", "border": "color.primary.300" },
          "hover": { "text": "color.white", "background": "color.primary.400", "border": "color.primary.400" },
          "disabled": { "text": "color.white", "background": "color.primary.300", "border": "color.primary.300", "opacity": 0.7 }
        },
        "secondary": {
          "default": { "text": "color.white", "background": "color.secondary.300", "border": "color.secondary.300" },
          "hover": { "text": "color.white", "background": "color.secondary.400", "border": "color.secondary.400" },
          "disabled": { "text": "color.white", "background": "color.secondary.300", "border": "color.secondary.300", "opacity": 0.7 }
        },
        "light": {
          "default": { "text": "color.black", "background": "color.white", "border": "color.white" },
          "hover": { "text": "color.white", "background": "color.black", "border": "color.black" },
          "disabled": { "text": "color.black", "background": "color.white", "border": "color.white", "opacity": 0.7 }
        },
        "dark": {
          "default": { "text": "color.white", "background": "color.black", "border": "color.black" },
          "hover": { "text": "color.white", "background": "color.gray.600", "border": "color.gray.600" },
          "disabled": { "text": "color.white", "background": "color.black", "border": "color.black", "opacity": 0.7 }
        },
        "tertiary": {
          "default": { "text": "color.white", "background": "color.secondary.300", "border": "color.secondary.300" },
          "hover": { "text": "color.white", "background": "color.secondary.400", "border": "color.secondary.400" },
          "disabled": { "text": "color.white", "background": "color.secondary.300", "border": "color.secondary.300", "opacity": 0.7 }
        }
      },

      "outline": {
        "primary": {
          "default": { "text": "color.primary.300", "background": "color.transparent", "border": "color.primary.300" },
          "hover": { "text": "color.white", "background": "color.primary.400", "border": "color.primary.400" },
          "disabled": { "text": "color.primary.300", "background": "color.transparent", "border": "color.primary.300", "opacity": 0.7 }
        },
        "secondary": {
          "default": { "text": "color.secondary.300", "background": "color.transparent", "border": "color.secondary.300" },
          "hover": { "text": "color.white", "background": "color.secondary.400", "border": "color.secondary.400" },
          "disabled": { "text": "color.secondary.300", "background": "color.transparent", "border": "color.secondary.300", "opacity": 0.7 }
        },
        "light": {
          "default": { "text": "color.white", "background": "color.transparent", "border": "color.white" },
          "hover": { "text": "color.black", "background": "color.white", "border": "color.white" },
          "disabled": { "text": "color.white", "background": "color.transparent", "border": "color.white", "opacity": 0.7 }
        },
        "dark": {
          "default": { "text": "color.black", "background": "color.transparent", "border": "color.black" },
          "hover": { "text": "color.white", "background": "color.gray.600", "border": "color.gray.600" },
          "disabled": { "text": "color.black", "background": "color.transparent", "border": "color.black", "opacity": 0.7 }
        },
        "tertiary": {
          "default": { "text": "color.secondary.300", "background": "color.transparent", "border": "color.secondary.300" },
          "hover": { "text": "color.white", "background": "color.secondary.400", "border": "color.secondary.400" },
          "disabled": { "text": "color.secondary.300", "background": "color.transparent", "border": "color.secondary.300", "opacity": 0.7 }
        }
      }
    },

    "properties": {
      "leftIcon": { "type": "boolean", "default": false },
      "rightIcon": { "type": "boolean", "default": false },
      "text": { "type": "text", "default": "{config.examples.defaultText}" },
      "icon": { "type": "text", "default": "{config.icons.default}" }
    }
  },

  "textLink": {
    "variants": {
      "state": ["default", "hover", "disabled"],
      "color": ["primary", "secondary", "dark", "light"]
    },

    "base": {
      "font": {
        "family": "Inter",
        "weight": 500,
        "size": 16,
        "lineHeight": 24
      },
      "gap": 4
    },

    "styles": {
      "primary": {
        "default": { "text": "color.primary.300" },
        "hover": { "text": "color.primary.400" },
        "disabled": { "text": "color.primary.300", "opacity": 0.7 }
      },
      "secondary": {
        "default": { "text": "color.secondary.300" },
        "hover": { "text": "color.secondary.400" },
        "disabled": { "text": "color.secondary.300", "opacity": 0.7 }
      },
      "dark": {
        "default": { "text": "color.gray.500" },
        "hover": { "text": "color.gray.600" },
        "disabled": { "text": "color.gray.500", "opacity": 0.7 }
      },
      "light": {
        "default": { "text": "color.white" },
        "hover": { "text": "color.white" },
        "disabled": { "text": "color.white", "opacity": 0.7 }
      }
    },

    "properties": {
      "text": { "type": "text", "default": "{config.examples.textLinkText}" },
      "icon": { "type": "text", "optional": true }
    }
  }
}
