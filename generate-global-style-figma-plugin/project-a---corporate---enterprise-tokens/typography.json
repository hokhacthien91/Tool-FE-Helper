{
  "$schema": "https://gravity-flex.dev/schemas/tokens.json",
  "$type": "typography",
  "$project": "Project A — Corporate / Enterprise",
  "textStyles": {
    "large": {
      "mobile": {
        "fontSize": "40px",
        "lineHeight": "40px",
        "fontWeight": "bold",
        "fontFamily": "Figtree"
      }
    },
    "medium": {
      "mobile": {
        "fontSize": "32px",
        "lineHeight": "32px",
        "fontWeight": "bold",
        "fontFamily": "Figtree"
      }
    },
    "small": {
      "mobile": {
        "fontSize": "24px",
        "lineHeight": "30px",
        "fontWeight": "semibold",
        "fontFamily": "Figtree"
      }
    },
    "links": {
      "mobile": {
        "fontSize": "12px",
        "lineHeight": "18px",
        "fontWeight": "bold",
        "fontFamily": "Figtree",
        "letterSpacing": "0.4000000059604645px"
      }
    },
    "default": {
      "mobile": {
        "fontSize": "16px",
        "fontWeight": "regular",
        "fontFamily": "Inter"
      }
    },
    "hover": {
      "mobile": {
        "fontSize": "16px",
        "fontWeight": "regular",
        "fontFamily": "Inter"
      }
    },
    "focus": {
      "mobile": {
        "fontSize": "16px",
        "fontWeight": "regular",
        "fontFamily": "Inter"
      }
    }
  },
  "linksColors": {
    "color": "#4a9fdc",
    "underline": "none",
    "font-weight": "inherit",
    "hover": {
      "color": "#2b7cba",
      "underline": "underline",
      "underline-offset": "0.2em"
    },
    "focus": {
      "color": "#4a9fdc",
      "outline-offset": "3px"
    }
  }
}