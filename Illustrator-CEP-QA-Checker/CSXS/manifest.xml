<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="com.oai.qachecker"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="QA Checker"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.oai.qachecker.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.oai.qachecker.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>QA Checker</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>520</Height>
              <Width>320</Width>
            </MinSize>
            <MaxSize>
              <Height>2000</Height>
              <Width>1200</Width>
            </MaxSize>
          </Geometry>
          <Icons/>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
